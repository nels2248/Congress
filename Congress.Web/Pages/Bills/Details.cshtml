@page
@model Congress.Web.Pages.Bills.DetailsModel

@{
    ViewData["Title"] = "Bill Prediction Details";
}

@if (Model.Bill == null)
{
    <h1>Bill Not Found</h1>

    <div class="alert alert-warning">
        <p>The requested bill prediction could not be found.</p>
    </div>

    <a asp-page="/Bills/Index" class="btn btn-primary">
        Back to Bill Predictions
    </a>
}
else
{
    <div class="mb-3">
        <a asp-page="/Bills/Index">&larr; Back to Bill Predictions</a>
    </div>

    <!-- Bill Header -->
    <div class="mb-4">
        <h1>@Model.Bill.Type @Model.Bill.BillNumber</h1>

        <h4 class="text-muted">
            @Model.Bill.Title
        </h4>
    </div>

    <!-- Prediction Summary -->
    <div class="card mb-4">
        <div class="card-body">

            <h5 class="card-title mb-4">
                Model Prediction
            </h5>

            <div class="row">

                <div class="col-md-3 mb-3">
                    <div class="text-muted">
                        Predicted Likelihood
                    </div>

                    <div class="display-6">
                        @(Model.Bill.PredictedProbability?.ToString("P1") ?? "N/A")
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="text-muted">
                        Model Category
                    </div>

                    <div class="fs-3">
                        @Model.Bill.PredictedOutcome
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="text-muted">
                        Prediction Run
                    </div>

                    <div class="fs-5">
                        @Model.Bill.RunAt.ToString("MMM d, yyyy")
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="text-muted">
                        Run ID
                    </div>

                    <div class="fs-5">
                        @Model.Bill.PredictionRunId
                    </div>
                </div>

            </div>

            <hr />

            <p class="text-muted mb-0">
                This probability is generated by a machine-learning model.
                It represents the model's estimated likelihood based on the
                characteristics of this bill and should not be interpreted
                as a guarantee of what will happen.
            </p>

        </div>
    </div>


    <!-- Model Explanation -->
    <div class="card mb-4">
        <div class="card-body">

            <h5 class="card-title">
                What Influenced the Prediction?
            </h5>

            <p class="text-muted">
                These are the model features that contributed most to the
                prediction. The direction shows whether each feature pushed
                the model's prediction higher or lower.
            </p>

            @if (Model.Reasons.Count == 0)
            {
                <div class="alert alert-info">
                    No explanation factors are available for this prediction.
                </div>
            }
            else
            {
                <div class="mt-4">

                    @foreach (var reason in Model.Reasons)
                    {
                        var contribution = reason.Contribution ?? 0;
                        var magnitude = Math.Abs(contribution);

                        // Scale the bar so the largest displayed
                        // contribution reaches approximately 100%.
                        var maxMagnitude = Model.Reasons
                            .Max(r => Math.Abs(r.Contribution ?? 0));

                        var barWidth = maxMagnitude > 0
                            ? (magnitude / maxMagnitude) * 100
                            : 0;

                        <div class="mb-4">

                            <div class="d-flex justify-content-between mb-1">

                                <strong>
                                    @reason.FeatureName
                                </strong>

                                <span class="text-muted">
                                    @contribution.ToString("0.0000")
                                </span>

                            </div>

                            <div class="progress" style="height: 24px;">

                                <div class="progress-bar
                                    @(reason.Direction == "increased"
                                        ? "bg-success"
                                        : "bg-danger")"
                                     role="progressbar"
                                     style="width: @barWidth.ToString("0.0")%;">

                                    @if (reason.Direction == "increased")
                                    {
                                        <span>↑ Increased</span>
                                    }
                                    else
                                    {
                                        <span>↓ Decreased</span>
                                    }

                                </div>

                            </div>

                            <small class="text-muted">
                                @if (reason.Direction == "increased")
                                {
                                    <span>
                                        This feature pushed the model's
                                        prediction higher.
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        This feature pushed the model's
                                        prediction lower.
                                    </span>
                                }
                            </small>

                        </div>
                    }

                </div>
            }

        </div>
    </div>


    <!-- How To Interpret -->
    <div class="card mb-4">
        <div class="card-body">

            <h5 class="card-title">
                How to Interpret These Factors
            </h5>

            <p>
                The model combines these factors into an underlying score.
                Each contribution represents how much an active feature
                moves that score.
            </p>

            <div class="row">

                <div class="col-md-6">

                    <div class="border rounded p-3 mb-3">

                        <strong>Direction</strong>

                        <p class="mb-0 mt-2">
                            A positive contribution pushes the model toward
                            a higher predicted likelihood. A negative
                            contribution pushes it toward a lower predicted
                            likelihood.
                        </p>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="border rounded p-3 mb-3">

                        <strong>Magnitude</strong>

                        <p class="mb-0 mt-2">
                            The larger the absolute value of the contribution,
                            the more influence that feature had on the model's
                            underlying score.
                        </p>

                    </div>

                </div>

            </div>

            <div class="alert alert-secondary mb-0">
                <strong>Important:</strong>
                Contribution values are not percentage-point changes in the
                prediction. They are contributions to the model's underlying
                log-odds score.
            </div>

        </div>
    </div>


    <!-- Technical Details -->
    <div class="card mb-4">

        <div class="card-body">

            <h5 class="card-title">
                Technical Model Details
            </h5>

            <div class="row">

                <div class="col-md-4">
                    <div class="text-muted">
                        Model
                    </div>

                    <div class="fs-5">
                        Logistic Regression
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="text-muted">
                        Prediction Run
                    </div>

                    <div class="fs-5">
                        @Model.Bill.PredictionRunId
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="text-muted">
                        Generated
                    </div>

                    <div class="fs-5">
                        @Model.Bill.RunAt.ToString("MMM d, yyyy h:mm tt")
                    </div>
                </div>

            </div>

            <hr />

            <p class="text-muted mb-0">
                The logistic regression model combines the learned feature
                coefficients, the active features for this bill, and an
                intercept to calculate an underlying score. That score is
                then converted into a probability between 0% and 100%.
            </p>

        </div>

    </div>


    <a asp-page="/Bills/Index" class="btn btn-outline-primary">
        &larr; Back to Bill Predictions
    </a>
}
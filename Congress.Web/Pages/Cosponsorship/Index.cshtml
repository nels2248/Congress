@page
@model Congress.Web.Pages.Cosponsorship.IndexModel

@{
    ViewData["Title"] = "Co-sponsorship";
}

<h1>Co-sponsorship</h1>

<p class="text-muted">
    Who signs on to whose bills. Each row is a co-sponsor; columns split their co-sponsored bills by the party of the bill's sponsor.
</p>

<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-md-2">
        <label class="form-label small text-muted">Sponsor Party</label>
        <select name="Party" class="form-select" onchange="this.form.submit()">
            <option value="">All</option>
            @foreach (var p in Model.Parties)
            {
                <option value="@p" selected="@(p == Model.Party)">@p</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label small text-muted">Sponsor State</label>
        <select name="State" class="form-select" onchange="this.form.submit()">
            <option value="">All</option>
            @foreach (var s in Model.States)
            {
                <option value="@s" selected="@(s == Model.State)">@s</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label small text-muted">Sponsor</label>
        <select name="Sponsor" class="form-select" onchange="this.form.submit()">
            <option value="">All</option>
            @foreach (var s in Model.Sponsors)
            {
                <option value="@s.Id" selected="@(s.Id == Model.Sponsor)">@s.Name</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label small text-muted">Co-sponsor name contains</label>
        <input name="Search" value="@Model.Search" class="form-control" placeholder="e.g. Klobuchar" />
    </div>
    <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Apply</button>
        <a asp-page="/Cosponsorship/Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card"><div class="card-body">
            <div class="text-muted">Co-sponsorships</div>
            <div class="fs-2">@Model.TotalCosponsorships.ToString("N0")</div>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card"><div class="card-body">
            <div class="text-muted">Co-sponsors</div>
            <div class="fs-2">@Model.TotalRows.ToString("N0")</div>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card"><div class="card-body">
            <div class="text-muted">Across Party Lines</div>
            <div class="fs-2">@Model.CrossPartyPct.ToString("P1")</div>
        </div></div>
    </div>
</div>

@if (Model.Rows.Count == 0)
{
    <div class="alert alert-info">No co-sponsorships match these filters.</div>
}
else
{
    @if (Model.TotalRows > Model.Rows.Count)
    {
        <p class="small text-muted">
            Showing the top @Model.Rows.Count of @Model.TotalRows.ToString("N0") co-sponsors. Use the filters to narrow it down.
        </p>
    }

    <div class="table-responsive">
        <table class="table table-striped table-hover table-sm align-middle">
            <thead>
                <tr>
                    <th>Co-sponsor</th>
                    <th>Party</th>
                    <th>State</th>
                    @foreach (var sp in Model.SponsorParties)
                    {
                        <th class="text-end">@sp-sponsored</th>
                    }
                    <th class="text-end">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td>
                            <a asp-page="/Members/Details" asp-route-id="@row.BioguideId">@row.FullName</a>
                        </td>
                        <td>@row.Party</td>
                        <td>@row.State</td>
                        @foreach (var sp in Model.SponsorParties)
                        {
                            row.BySponsorParty.TryGetValue(sp, out var n);
                            <td class="text-end @(sp != row.Party && n > 0 ? "fw-semibold" : "")">
                                @(n == 0 ? "" : n.ToString("N0"))
                            </td>
                        }
                        <td class="text-end">@row.Total.ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="small text-muted">Bold = co-sponsoring a bill from the other party.</p>
}

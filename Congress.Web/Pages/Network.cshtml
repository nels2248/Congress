@page
@model Congress.Web.Pages.NetworkModel

@{
    ViewData["Title"] = "Congressional Network";
}

<style>
    .network-page {
        width: 100%;
        height: calc(100vh - 100px);
        min-height: 700px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .network-toolbar {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 16px;
        border-bottom: 1px solid #ddd;
        background: #fff;
        flex-wrap: wrap;
    }

    .toolbar-group {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .toolbar-label {
        font-size: 13px;
        font-weight: 600;
        color: #444;
        white-space: nowrap;
    }

    .network-toolbar select {
        height: 34px;
        padding: 4px 8px;
        border: 1px solid #bbb;
        border-radius: 5px;
        background: white;
        font-size: 14px;
    }

    .people-selector {
        position: relative;
    }

    .people-button {
        height: 34px;
        min-width: 210px;
        padding: 4px 32px 4px 10px;
        border: 1px solid #bbb;
        border-radius: 5px;
        background: white;
        text-align: left;
        font-size: 14px;
        cursor: pointer;
        position: relative;
    }

    .people-button::after {
        content: "▼";
        position: absolute;
        right: 10px;
        top: 8px;
        font-size: 10px;
        color: #666;
    }

    .people-menu {
        display: none;
        position: absolute;
        z-index: 1000;
        top: 40px;
        left: 0;
        width: 330px;
        max-height: 500px;
        background: white;
        border: 1px solid #bbb;
        border-radius: 5px;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
        overflow: hidden;
    }

    .people-menu.open {
        display: block;
    }

    .people-actions {
        display: flex;
        gap: 8px;
        padding: 9px;
        border-bottom: 1px solid #ddd;
        background: #f7f7f7;
    }

    .people-actions button {
        padding: 5px 9px;
        border: 1px solid #aaa;
        border-radius: 4px;
        background: white;
        cursor: pointer;
        font-size: 12px;
    }

    .people-actions button:hover {
        background: #eee;
    }

    .people-list {
        max-height: 440px;
        overflow-y: auto;
        padding: 5px 0;
    }

    .person-option {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 5px 10px;
        cursor: pointer;
        font-size: 13px;
    }

    .person-option:hover {
        background: #f0f0f0;
    }

    .person-option input {
        margin: 0;
    }

    .load-button {
        height: 34px;
        padding: 0 16px;
        border: 1px solid #333;
        border-radius: 5px;
        background: #333;
        color: white;
        font-weight: 600;
        cursor: pointer;
    }

    .load-button:hover {
        background: #111;
    }

    .load-button:disabled {
        background: #999;
        border-color: #999;
        cursor: not-allowed;
    }

    .network-status {
        font-size: 13px;
        color: #666;
        margin-left: auto;
    }

    .network-content {
        flex: 1;
        min-height: 0;
        display: flex;
        overflow: hidden;
        background: #fafafa;
    }

    #network {
        flex: 1;
        min-width: 0;
        min-height: 0;
        position: relative;
        overflow: hidden;
    }

    #network svg {
        display: block;
        width: 100%;
        height: 100%;
    }

    .connections-panel {
        flex: 0 0 330px;
        width: 330px;
        border-left: 1px solid #ddd;
        background: white;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .connections-header {
        flex-shrink: 0;
        padding: 16px;
        border-bottom: 1px solid #ddd;
    }

    .connections-title {
        font-size: 18px;
        font-weight: 700;
        color: #222;
        margin: 0;
    }

    .connections-subtitle {
        margin-top: 4px;
        font-size: 12px;
        color: #777;
    }

    .connections-list {
        flex: 1;
        overflow-y: auto;
    }

    .connection-row {
        display: grid;
        grid-template-columns: 30px 1fr auto;
        gap: 8px;
        align-items: center;
        padding: 10px 12px;
        border-bottom: 1px solid #eee;
    }

    .connection-row:hover {
        background: #f7f7f7;
    }

    .connection-rank {
        font-size: 12px;
        font-weight: 700;
        color: #888;
        text-align: center;
    }

    .connection-people {
        min-width: 0;
    }

    .connection-person {
        font-size: 13px;
        font-weight: 600;
        color: #222;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .connection-person + .connection-person {
        margin-top: 2px;
    }

    .connection-meta {
        margin-top: 3px;
        font-size: 11px;
        color: #888;
    }

    .connection-count {
        text-align: right;
        white-space: nowrap;
    }

    .connection-count-number {
        font-size: 16px;
        font-weight: 700;
        color: #333;
    }

    .connection-count-label {
        font-size: 10px;
        color: #888;
    }

    .connection-empty {
        padding: 30px 20px;
        text-align: center;
        color: #888;
        font-size: 13px;
    }

    .network-tooltip {
        position: fixed;
        display: none;
        z-index: 2000;
        max-width: 320px;
        padding: 10px 12px;
        background: rgba(20, 20, 20, 0.94);
        color: white;
        border-radius: 5px;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.3);
        font-size: 12px;
        line-height: 1.45;
        pointer-events: none;
    }

    .network-tooltip-title {
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .network-tooltip-row {
        margin-top: 2px;
    }

    .legend {
        position: absolute;
        left: 15px;
        bottom: 15px;
        z-index: 10;
        padding: 10px 12px;
        background: rgba(255, 255, 255, 0.92);
        border: 1px solid #ddd;
        border-radius: 5px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        font-size: 12px;
    }

    .legend-title {
        font-weight: 700;
        margin-bottom: 7px;
    }

    .legend-row {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-top: 4px;
    }

    .legend-node {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        border: 1px solid #fff;
        box-shadow: 0 0 0 1px #aaa;
    }

    .legend-line {
        width: 28px;
        height: 0;
        border-top: 3px solid #555;
    }

    .legend-line.dashed {
        border-top-style: dashed;
    }

    .party-democrat {
        background: #2166ac;
    }

    .party-republican {
        background: #b2182b;
    }

    .party-other {
        background: #777;
    }

    @@media (max-width: 900px) {
        .network-content {
            flex-direction: column;
        }

        .connections-panel {
            flex: 0 0 300px;
            width: 100%;
            border-left: none;
            border-top: 1px solid #ddd;
        }

        .network-status {
            width: 100%;
            margin-left: 0;
        }
    }
</style>

<div class="network-page">

    <div class="network-toolbar">

        <div class="toolbar-group">
            <span class="toolbar-label">People</span>

            <div class="people-selector">

                <button type="button"
                        id="peopleButton"
                        class="people-button">
                    Loading people...
                </button>

                <div id="peopleMenu" class="people-menu">

                    <div class="people-actions">
                        <button type="button" id="selectAllButton">
                            Select All
                        </button>

                        <button type="button" id="clearAllButton">
                            Clear All
                        </button>
                    </div>

                    <div id="peopleList" class="people-list">
                    </div>

                </div>
            </div>
        </div>

        <div class="toolbar-group">
            <label class="toolbar-label" for="networkSize">
                Network Size
            </label>

            <select id="networkSize">
                @for (var i = 2; i <= 1000; i++)
                {
                    if (i == 50)
                    {
                        <option value="@i" selected>@i</option>
                    }
                    else
                    {
                        <option value="@i">@i</option>
                    }
                }
            </select>
        </div>

        <div class="toolbar-group">
            <label class="toolbar-label" for="minSharedBills">
                Min Shared Bills
            </label>

            <select id="minSharedBills">
                @for (var i = 1; i <= 100; i++)
                {
                    if (i == 50)
                    {
                        <option value="@i" selected>@i</option>
                    }
                    else
                    {
                        <option value="@i">@i</option>
                    }
                }
            </select>
        </div>

        <button type="button"
                id="loadNetworkButton"
                class="load-button">
            Load Network
        </button>

        <div id="networkStatus" class="network-status">
            Loading members...
        </div>

    </div>

    <div class="network-content">

        <div id="network">

            <div class="legend">

                <div class="legend-title">
                    Legend
                </div>

                <div class="legend-row">
                    <span class="legend-node party-democrat"></span>
                    <span>Democrat</span>
                </div>

                <div class="legend-row">
                    <span class="legend-node party-republican"></span>
                    <span>Republican</span>
                </div>

                <div class="legend-row">
                    <span class="legend-node party-other"></span>
                    <span>Other</span>
                </div>

                <div class="legend-row">
                    <span class="legend-line"></span>
                    <span>Same party</span>
                </div>

                <div class="legend-row">
                    <span class="legend-line dashed"></span>
                    <span>Cross party</span>
                </div>

            </div>

        </div>

        <div class="connections-panel">

            <div class="connections-header">

                <h2 class="connections-title">
                    Top 20 Connections
                </h2>

                <div class="connections-subtitle">
                    Strongest relationships in displayed network
                </div>

            </div>

            <div id="connectionsList" class="connections-list">
                <div class="connection-empty">
                    Load a network to see connections.
                </div>
            </div>

        </div>

    </div>

</div>

<div id="networkTooltip" class="network-tooltip"></div>

<script src="https://d3js.org/d3.v7.min.js"></script>

<script>

    // ========================================================
    // GLOBAL STATE
    // ========================================================

    let allMembers = [];
    let selectedIds = new Set();

    let svg = null;
    let simulation = null;


    // ========================================================
    // LOAD MEMBERS
    // ========================================================

    async function loadMembers() {

        const status = document.getElementById("networkStatus");

        try {

            status.textContent = "Loading members...";

            const response =
                await fetch("?handler=Members");

            if (!response.ok) {
                throw new Error(
                    `Members request failed: ${response.status}`
                );
            }

            allMembers = await response.json();

            selectedIds =
                new Set(
                    allMembers.map(
                        person => String(person.id)
                    )
                );

            renderPeopleList();
            updatePeopleButton();

            status.textContent =
                `${allMembers.length.toLocaleString()} members loaded`;

        }
        catch (error) {

            console.error(error);

            status.textContent =
                "Error loading members";

            document.getElementById("peopleList").innerHTML =
                `<div class="connection-empty">
                    Unable to load members.
                </div>`;
        }
    }


    // ========================================================
    // PEOPLE LIST
    // ========================================================

    function renderPeopleList() {

        const list =
            document.getElementById("peopleList");

        list.innerHTML = "";

        allMembers.forEach(person => {

            const label =
                document.createElement("label");

            label.className =
                "person-option";

            const checkbox =
                document.createElement("input");

            checkbox.type = "checkbox";

            checkbox.value =
                String(person.id);

            checkbox.checked =
                selectedIds.has(
                    String(person.id)
                );

            checkbox.addEventListener(
                "change",
                () => {

                    const id =
                        String(person.id);

                    if (checkbox.checked) {
                        selectedIds.add(id);
                    }
                    else {
                        selectedIds.delete(id);
                    }

                    updatePeopleButton();
                }
            );

            const text =
                document.createElement("span");

            text.textContent =
                `${person.name} (${person.party || "?"}-${person.state || "?"})`;

            label.appendChild(checkbox);
            label.appendChild(text);

            list.appendChild(label);
        });
    }


    // ========================================================
    // PEOPLE BUTTON
    // ========================================================

    function updatePeopleButton() {

        const button =
            document.getElementById("peopleButton");

        if (selectedIds.size === 0) {

            button.textContent =
                "No people selected";

            return;
        }

        if (selectedIds.size === allMembers.length) {

            button.textContent =
                "All people";

            return;
        }

        button.textContent =
            `${selectedIds.size} people selected`;
    }


    // ========================================================
    // PEOPLE DROPDOWN
    // ========================================================

    document
        .getElementById("peopleButton")
        .addEventListener(
            "click",
            event => {

                event.stopPropagation();

                const menu =
                    document.getElementById("peopleMenu");

                menu.classList.toggle("open");
            }
        );


    document
        .getElementById("peopleMenu")
        .addEventListener(
            "click",
            event => {

                event.stopPropagation();
            }
        );


    document.addEventListener(
        "click",
        () => {

            document
                .getElementById("peopleMenu")
                .classList.remove("open");
        }
    );


    // ========================================================
    // SELECT ALL
    // ========================================================

    document
        .getElementById("selectAllButton")
        .addEventListener(
            "click",
            () => {

                selectedIds =
                    new Set(
                        allMembers.map(
                            person => String(person.id)
                        )
                    );

                renderPeopleList();
                updatePeopleButton();
            }
        );


    // ========================================================
    // CLEAR ALL
    // ========================================================

    document
        .getElementById("clearAllButton")
        .addEventListener(
            "click",
            () => {

                selectedIds =
                    new Set();

                renderPeopleList();
                updatePeopleButton();
            }
        );


    // ========================================================
    // LOAD NETWORK
    // ========================================================

    document
        .getElementById("loadNetworkButton")
        .addEventListener(
            "click",
            loadNetwork
        );


    async function loadNetwork() {

        const button =
            document.getElementById(
                "loadNetworkButton"
            );

        const status =
            document.getElementById(
                "networkStatus"
            );

        if (selectedIds.size === 0) {

            status.textContent =
                "Select at least one person.";

            return;
        }

        const networkSize =
            Number(
                document.getElementById(
                    "networkSize"
                ).value
            );

        const minSharedBills =
            Number(
                document.getElementById(
                    "minSharedBills"
                ).value
            );

        button.disabled = true;

        status.textContent =
            "Loading network...";

        try {

            const params =
                new URLSearchParams();

            params.set(
                "selectedIds",
                [...selectedIds].join(",")
            );

            params.set(
                "networkSize",
                String(networkSize)
            );

            params.set(
                "minSharedBills",
                String(minSharedBills)
            );

            const response =
                await fetch(
                    `?handler=Data&${params.toString()}`
                );

            if (!response.ok) {

                throw new Error(
                    `Network request failed: ${response.status}`
                );
            }

            const data =
                await response.json();

            console.log(
                "Network data:",
                data
            );

            drawNetwork(data);

            updateConnectionsPanel(data);

            const nodeCount =
                data.nodes?.length || 0;

            const edgeCount =
                data.edges?.length || 0;

            status.textContent =
                `${nodeCount.toLocaleString()} people • ` +
                `${edgeCount.toLocaleString()} connections`;

        }
        catch (error) {

            console.error(error);

            status.textContent =
                "Error loading network.";

            const container =
                document.getElementById("network");

            container
                .querySelectorAll("svg")
                .forEach(
                    element => element.remove()
                );
        }
        finally {

            button.disabled = false;
        }
    }


    // ========================================================
    // CONNECTIONS PANEL
    // ========================================================

    function updateConnectionsPanel(data) {

        const container =
            document.getElementById(
                "connectionsList"
            );

        container.innerHTML = "";

        if (!data ||
            !data.nodes ||
            !data.edges ||
            data.edges.length === 0) {

            container.innerHTML =
                `<div class="connection-empty">
                    No connections found.
                </div>`;

            return;
        }

        const nodeMap =
            new Map(
                data.nodes.map(
                    node => [
                        String(node.id),
                        node
                    ]
                )
            );

        const rankedEdges =
            [...data.edges]
                .sort(
                    (a, b) =>
                        (Number(b.sharedBillCount) || 0) -
                        (Number(a.sharedBillCount) || 0)
                )
                .slice(0, 20);

        rankedEdges.forEach(
            (edge, index) => {

                const source =
                    nodeMap.get(
                        String(
                            typeof edge.source === "object"
                                ? edge.source.id
                                : edge.source
                        )
                    );

                const target =
                    nodeMap.get(
                        String(
                            typeof edge.target === "object"
                                ? edge.target.id
                                : edge.target
                        )
                    );

                if (!source || !target) {
                    return;
                }

                const sourceParty =
                    source.party || "?";

                const targetParty =
                    target.party || "?";

                const relationshipType =
                    sourceParty === targetParty
                        ? "Same party"
                        : "Cross party";

                const row =
                    document.createElement("div");

                row.className =
                    "connection-row";

                const rank =
                    document.createElement("div");

                rank.className =
                    "connection-rank";

                rank.textContent =
                    String(index + 1);

                const people =
                    document.createElement("div");

                people.className =
                    "connection-people";

                const sourceName =
                    document.createElement("div");

                sourceName.className =
                    "connection-person";

                sourceName.textContent =
                    source.name || source.id;

                const targetName =
                    document.createElement("div");

                targetName.className =
                    "connection-person";

                targetName.textContent =
                    target.name || target.id;

                const meta =
                    document.createElement("div");

                meta.className =
                    "connection-meta";

                meta.textContent =
                    `${sourceParty}-${source.state || "?"} • ` +
                    `${targetParty}-${target.state || "?"} • ` +
                    relationshipType;

                people.appendChild(sourceName);
                people.appendChild(targetName);
                people.appendChild(meta);

                const count =
                    document.createElement("div");

                count.className =
                    "connection-count";

                const countNumber =
                    document.createElement("div");

                countNumber.className =
                    "connection-count-number";

                countNumber.textContent =
                    Number(
                        edge.sharedBillCount || 0
                    ).toLocaleString();

                const countLabel =
                    document.createElement("div");

                countLabel.className =
                    "connection-count-label";

                countLabel.textContent =
                    "shared bills";

                count.appendChild(countNumber);
                count.appendChild(countLabel);

                row.appendChild(rank);
                row.appendChild(people);
                row.appendChild(count);

                container.appendChild(row);
            }
        );
    }


    // ========================================================
    // DRAW NETWORK
    // ========================================================

    function drawNetwork(data) {

        const container =
            document.getElementById("network");

        if (!data ||
            !Array.isArray(data.nodes) ||
            !Array.isArray(data.edges)) {

            console.error(
                "Invalid network data:",
                data
            );

            return;
        }

        const width =
            container.clientWidth;

        const height =
            container.clientHeight;

        if (width <= 0 || height <= 0) {

            console.warn(
                "Network container has no dimensions."
            );

            return;
        }


        // ====================================================
        // STOP PREVIOUS SIMULATION
        // ====================================================

        if (simulation) {

            simulation.stop();
            simulation = null;
        }


        // ====================================================
        // REMOVE PREVIOUS SVG
        // ====================================================

        container
            .querySelectorAll("svg")
            .forEach(
                element => element.remove()
            );


        // ====================================================
        // HIDE TOOLTIP
        // ====================================================

        hideConnectionTooltip();


        // ====================================================
        // SVG
        // ====================================================

        svg =
            d3.select(container)
                .append("svg")
                .attr("width", width)
                .attr("height", height)
                .attr("viewBox", `0 0 ${width} ${height}`);


        // ====================================================
        // GRAPH GROUP
        // ====================================================

        const graph =
            svg.append("g")
                .attr(
                    "class",
                    "network-graph"
                );


        // ====================================================
        // ZOOM / PAN
        // ====================================================

        const zoom =
            d3.zoom()
                .scaleExtent([
                    0.35,
                    3
                ])
                .on(
                    "zoom",
                    event => {

                        graph.attr(
                            "transform",
                            event.transform
                        );
                    }
                );

        svg.call(zoom);

        svg.on(
            "dblclick.zoom",
            null
        );

        svg.on(
            "dblclick",
            () => {

                svg
                    .transition()
                    .duration(500)
                    .call(
                        zoom.transform,
                        d3.zoomIdentity
                    );
            }
        );


        // ====================================================
        // NODE SIZE
        // ====================================================

        const nodeRadius = 12;


        // ====================================================
        // EDGE VISUAL PRIORITY
        //
        // Top 20 = strong visual lines
        // Everything else = thin gray background/noise
        // ====================================================

        const rankedEdges =
            [...data.edges]
                .sort(
                    (a, b) =>
                        (Number(b.sharedBillCount) || 0) -
                        (Number(a.sharedBillCount) || 0)
                );

        const importantEdges =
            rankedEdges.slice(0, 20);

        const importantEdgeSet =
            new Set(importantEdges);

        const importantMax =
            d3.max(
                importantEdges,
                d => Number(
                    d.sharedBillCount
                ) || 0
            ) || 1;

        const importantMin =
            d3.min(
                importantEdges,
                d => Number(
                    d.sharedBillCount
                ) || 0
            ) || 1;

        const importantWidthScale =
            d3.scaleLinear()
                .domain([
                    importantMin,
                    importantMax
                ])
                .range([
                    3,
                    10
                ])
                .clamp(true);

        function isImportantEdge(edge) {

            return importantEdgeSet.has(
                edge
            );
        }

        function getEdgeWidth(edge) {

            if (!isImportantEdge(edge)) {
                return 1;
            }

            return importantWidthScale(
                Number(
                    edge.sharedBillCount
                ) || 0
            );
        }


        // ====================================================
        // NODE LOOKUP
        // ====================================================

        const nodeMap =
            new Map(
                data.nodes.map(
                    node => [
                        String(node.id),
                        node
                    ]
                )
            );


        // ====================================================
        // LINKS
        // ====================================================

        const links =
            graph.append("g")
                .attr(
                    "class",
                    "links"
                )
                .selectAll("line")
                .data(
                    data.edges
                )
                .join("line")
                .attr(
                    "stroke",
                    "#777"
                )
                .attr(
                    "stroke-width",
                    d => getEdgeWidth(d)
                )
                .attr(
                    "stroke-opacity",
                    d =>
                        isImportantEdge(d)
                            ? 0.80
                            : 0.25
                )
                .attr(
                    "stroke-dasharray",
                    d => {

                        const source =
                            getEndpointNode(
                                d.source
                            );

                        const target =
                            getEndpointNode(
                                d.target
                            );

                        if (!source || !target) {
                            return null;
                        }

                        return (
                            source.party &&
                            target.party &&
                            source.party !== target.party
                        )
                            ? "6,4"
                            : null;
                    }
                )
                .on(
                    "mouseenter",
                    function(event, edge) {

                        showConnectionTooltip(
                            event,
                            edge,
                            nodeMap
                        );
                    }
                )
                .on(
                    "mousemove",
                    function(event) {

                        positionTooltip(
                            event
                        );
                    }
                )
                .on(
                    "mouseleave",
                    hideConnectionTooltip
                );


        // ====================================================
        // NODE GROUPS
        // ====================================================

        const nodeGroups =
            graph.append("g")
                .attr(
                    "class",
                    "nodes"
                )
                .selectAll("g")
                .data(
                    data.nodes
                )
                .join("g")
                .attr(
                    "class",
                    "node"
                );


        // ====================================================
        // NODE CIRCLES
        // ====================================================

        nodeGroups
            .append("circle")
            .attr(
                "r",
                nodeRadius
            )
            .attr(
                "fill",
                getPartyColor
            )
            .attr(
                "stroke",
                d =>
                    d.selected
                        ? "#111"
                        : "#fff"
            )
            .attr(
                "stroke-width",
                d =>
                    d.selected
                        ? 3
                        : 1.5
            )
            .on(
                "mouseenter",
                function(event, node) {

                    d3.select(this)
                        .attr(
                            "stroke",
                            "#111"
                        )
                        .attr(
                            "stroke-width",
                            3
                        );

                    showNodeTooltip(
                        event,
                        node
                    );
                }
            )
            .on(
                "mousemove",
                function(event) {

                    positionTooltip(
                        event
                    );
                }
            )
            .on(
                "mouseleave",
                function(event, node) {

                    d3.select(this)
                        .attr(
                            "stroke",
                            node.selected
                                ? "#111"
                                : "#fff"
                        )
                        .attr(
                            "stroke-width",
                            node.selected
                                ? 3
                                : 1.5
                        );

                    hideConnectionTooltip();
                }
            )
            .call(
                d3.drag()
                    .on(
                        "start",
                        dragStarted
                    )
                    .on(
                        "drag",
                        dragged
                    )
                    .on(
                        "end",
                        dragEnded
                    )
            );


        // ====================================================
        // NODE LABELS
        // ====================================================

        nodeGroups
            .append("text")
            .attr(
                "x",
                nodeRadius + 5
            )
            .attr(
                "y",
                4
            )
            .attr(
                "font-size",
                "11px"
            )
            .attr(
                "font-family",
                "Arial, sans-serif"
            )
            .attr(
                "fill",
                "#333"
            )
            .style(
                "pointer-events",
                "none"
            )
            .text(
                d => d.name || d.id
            );


        // ====================================================
        // FORCE SIMULATION
        // ====================================================

        simulation =
            d3.forceSimulation(
                data.nodes
            )
            .force(
                "link",
                d3.forceLink(
                    data.edges
                )
                .id(
                    d => String(d.id)
                )
                .distance(
                    d => {

                        const count =
                            Number(
                                d.sharedBillCount
                            ) || 0;

                        if (count >= 100) {
                            return 90;
                        }

                        if (count >= 75) {
                            return 110;
                        }

                        if (count >= 50) {
                            return 130;
                        }

                        return 155;
                    }
                )
                .strength(
                    d => {

                        const count =
                            Number(
                                d.sharedBillCount
                            ) || 0;

                        return Math.min(
                            1,
                            0.15 +
                            count / 150
                        );
                    }
                )
            )
            .force(
                "charge",
                d3.forceManyBody()
                    .strength(-110)
            )
            .force(
                "center",
                d3.forceCenter(
                    width / 2,
                    height / 2
                )
            )
            .force(
                "collision",
                d3.forceCollide(
                    nodeRadius + 10
                )
            )
            .on(
                "tick",
                () => {

                    links
                        .attr(
                            "x1",
                            d => getX(d.source)
                        )
                        .attr(
                            "y1",
                            d => getY(d.source)
                        )
                        .attr(
                            "x2",
                            d => getX(d.target)
                        )
                        .attr(
                            "y2",
                            d => getY(d.target)
                        );

                    nodeGroups.attr(
                        "transform",
                        d =>
                            `translate(${getX(d)},${getY(d)})`
                    );
                }
            );


        // ====================================================
        // INITIAL VIEW
        // ====================================================

        const scale =
            Math.min(
                width / 1000,
                height / 750
            );

        const initialScale =
            Math.max(
                0.45,
                Math.min(
                    scale,
                    1
                )
            );

        const initialX =
            width / 2 -
            (width / 2) *
            initialScale;

        const initialY =
            height / 2 -
            (height / 2) *
            initialScale;

        svg.call(
            zoom.transform,
            d3.zoomIdentity
                .translate(
                    initialX,
                    initialY
                )
                .scale(
                    initialScale
                )
        );
    }


    // ========================================================
    // ENDPOINT NODE
    // ========================================================

    function getEndpointNode(endpoint) {

        if (!endpoint) {
            return null;
        }

        if (typeof endpoint === "object") {
            return endpoint;
        }

        if (Array.isArray(endpoint)) {
            return endpoint[0] || null;
        }

        return null;
    }


    // ========================================================
    // NODE X / Y
    // ========================================================

    function getX(node) {

        return Number.isFinite(node.x)
            ? node.x
            : 0;
    }


    function getY(node) {

        return Number.isFinite(node.y)
            ? node.y
            : 0;
    }


    // ========================================================
    // PARTY COLOR
    // ========================================================

    function getPartyColor(node) {

        const party =
            String(
                node.party || ""
            ).toUpperCase();

        if (party === "D") {
            return "#2166ac";
        }

        if (party === "R") {
            return "#b2182b";
        }

        return "#777";
    }


    // ========================================================
    // TOOLTIP HTML ESCAPING
    // ========================================================

    function escapeHtml(value) {

        const div =
            document.createElement("div");

        div.textContent =
            value == null
                ? ""
                : String(value);

        return div.innerHTML;
    }


    // ========================================================
    // CONNECTION TOOLTIP
    // ========================================================

    function showConnectionTooltip(
        event,
        edge,
        nodeMap
    ) {

        const sourceId =
            typeof edge.source === "object"
                ? edge.source.id
                : edge.source;

        const targetId =
            typeof edge.target === "object"
                ? edge.target.id
                : edge.target;

        const source =
            nodeMap.get(
                String(sourceId)
            );

        const target =
            nodeMap.get(
                String(targetId)
            );

        if (!source || !target) {
            return;
        }

        const sharedBills =
            Number(
                edge.sharedBillCount
            ) || 0;

        const sameParty =
            source.party &&
            target.party &&
            source.party === target.party;

        const tooltip =
            document.getElementById(
                "networkTooltip"
            );

        tooltip.innerHTML = `
            <div class="network-tooltip-title">
                ${escapeHtml(source.name || source.id)}
                ↔
                ${escapeHtml(target.name || target.id)}
            </div>

            <div class="network-tooltip-row">
                ${escapeHtml(source.party || "?")}-${escapeHtml(source.state || "?")}
                ↔
                ${escapeHtml(target.party || "?")}-${escapeHtml(target.state || "?")}
            </div>

            <div class="network-tooltip-row">
                <strong>${sharedBills.toLocaleString()}</strong>
                shared bills
            </div>

            <div class="network-tooltip-row">
                ${sameParty ? "Same party" : "Cross party"}
            </div>
        `;

        tooltip.style.display =
            "block";

        positionTooltip(event);
    }


    // ========================================================
    // NODE TOOLTIP
    // ========================================================

    function showNodeTooltip(
        event,
        node
    ) {

        const tooltip =
            document.getElementById(
                "networkTooltip"
            );

        const relationshipCount =
            Number(
                node.relationshipCount
            ) || 0;

        const billCount =
            Number(
                node.billCount
            ) || 0;

        tooltip.innerHTML = `
            <div class="network-tooltip-title">
                ${escapeHtml(node.name || node.id)}
            </div>

            <div class="network-tooltip-row">
                ${escapeHtml(node.party || "?")}-${escapeHtml(node.state || "?")}
            </div>

            <div class="network-tooltip-row">
                Relationships:
                <strong>${relationshipCount.toLocaleString()}</strong>
            </div>

            <div class="network-tooltip-row">
                Bills:
                <strong>${billCount.toLocaleString()}</strong>
            </div>
        `;

        tooltip.style.display =
            "block";

        positionTooltip(event);
    }


    // ========================================================
    // TOOLTIP POSITION
    // ========================================================

    function positionTooltip(event) {

        const tooltip =
            document.getElementById(
                "networkTooltip"
            );

        if (tooltip.style.display === "none") {
            return;
        }

        const offset = 14;

        let left =
            event.clientX +
            offset;

        let top =
            event.clientY +
            offset;

        const rect =
            tooltip.getBoundingClientRect();

        if (
            left + rect.width >
            window.innerWidth - 10
        ) {

            left =
                event.clientX -
                rect.width -
                offset;
        }

        if (
            top + rect.height >
            window.innerHeight - 10
        ) {

            top =
                event.clientY -
                rect.height -
                offset;
        }

        tooltip.style.left =
            `${Math.max(5, left)}px`;

        tooltip.style.top =
            `${Math.max(5, top)}px`;
    }


    // ========================================================
    // HIDE TOOLTIP
    // ========================================================

    function hideConnectionTooltip() {

        const tooltip =
            document.getElementById(
                "networkTooltip"
            );

        tooltip.style.display =
            "none";
    }


    // ========================================================
    // DRAG
    // ========================================================

    function dragStarted(
        event,
        d
    ) {

        if (!event.active) {

            simulation.alphaTarget(
                0.3
            ).restart();
        }

        d.fx = d.x;
        d.fy = d.y;

        event.sourceEvent.stopPropagation();
    }


    function dragged(
        event,
        d
    ) {

        d.fx = event.x;
        d.fy = event.y;
    }


    function dragEnded(
        event,
        d
    ) {

        if (!event.active) {

            simulation.alphaTarget(
                0
            );
        }

        d.fx = null;
        d.fy = null;
    }


    // ========================================================
    // RESIZE
    // ========================================================

    window.addEventListener(
        "resize",
        () => {

            if (!svg || !simulation) {
                return;
            }

            const container =
                document.getElementById(
                    "network"
                );

            const width =
                container.clientWidth;

            const height =
                container.clientHeight;

            if (width <= 0 || height <= 0) {
                return;
            }

            svg
                .attr(
                    "width",
                    width
                )
                .attr(
                    "height",
                    height
                )
                .attr(
                    "viewBox",
                    `0 0 ${width} ${height}`
                );

            simulation
                .force(
                    "center",
                    d3.forceCenter(
                        width / 2,
                        height / 2
                    )
                )
                .alpha(
                    0.2
                )
                .restart();
        }
    );


    // ========================================================
    // INITIAL LOAD
    // ========================================================

    loadMembers();

</script>
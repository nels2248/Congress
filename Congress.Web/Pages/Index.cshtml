@page
@model IndexModel
@{
ViewData["Title"] = "Congress 119";
}

<h1>Congress 119 Bill Tracker</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Bill #</th>
            <th>Title</th>
            <th>Chamber</th>
            <th>Policy Area</th>
            <th>Introduced</th>
            <th>Latest Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var bill in Model.Bills)
        {
            <tr>
                <td>@bill.BillNumber</td>
                <td>@bill.Title</td>
                <td>@bill.OriginChamber</td>
                <td>@bill.PolicyArea</td>
                <td>@bill.IntroducedDate?.ToString("d")</td>
                <td>@bill.LatestAction</td>
            </tr>
        }
    </tbody>
</table>

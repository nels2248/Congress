@page
@model Congress.Web.Pages.Map.IndexModel

@{
    ViewData["Title"] = "Congressional District Map";
}

<link rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="container-fluid px-0">

    <div class="mb-4">
        <h1 class="display-5 fw-bold">Congressional District Map</h1>

        <p class="lead text-muted">
            Current U.S. House congressional district boundaries.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div id="districtMap"
                 style="height: 700px; width: 100%;">
            </div>
        </div>
    </div>

</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
    console.log("Map script starting");

    var map = L.map("districtMap").setView(
        [39.8283, -98.5795],
        4
    );

    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        attribution: "&copy; OpenStreetMap contributors"
    }).addTo(map);

    console.log("Leaflet map initialized");

    map.on("click", function (e) {
        console.log("Map clicked:", e.latlng);
    });

    map.on("popupopen", function () { console.log("popupopen"); });
    map.on("popupclose", function () { console.log("popupclose"); });

    function hasCoords(c) {
        return Array.isArray(c) &&
            (typeof c[0] === "number" || c.some(hasCoords));
    }

    fetch("/data/congressional-districts-120.simplified.geojson")
        .then(function (response) {

            console.log(
                "District response:",
                response.status
            );

            if (!response.ok) {
                throw new Error(
                    "District request failed: " +
                    response.status
                );
            }

            return response.json();
        })
        .then(function (data) {

            console.log(
                "First feature properties:",
                data.features[0].properties
            );

            var before = data.features.length;

            data.features = data.features.filter(function (f) {
                return f.geometry &&
                    hasCoords(f.geometry.coordinates) &&
                    (f.properties || {}).CD120FP !== "ZZ";
            });

            console.log(
                "Dropped empty/undefined features:",
                before - data.features.length
            );

            L.geoJSON(data, {

                style: function () {
                    return {
                        color: "#333",
                        weight: 1,
                        opacity: 0.8,
                        fillOpacity: 0.15
                    };
                },

                onEachFeature: function (feature, layer) {

                    var properties =
                        feature.properties || {};

                    var district =
                        properties.CD120FP ||
                        properties.CD119FP ||
                        properties.CDFP ||
                        properties.CD120 ||
                        properties.CD119 ||
                        properties.CD ||
                        properties.GEOID ||
                        "Unknown";

                    var name =
                        properties.NAMELSAD ||
                        properties.NAME ||
                        "Congressional District";

                    layer.on("click", function (e) {
                        console.log("Layer clicked:", name, district);

                        var popup = L.popup({ closeOnClick: false })
                            .setLatLng(e.latlng)
                            .setContent(
                                "<strong>" + name + "</strong><br>" +
                                "District: "
                            )
                            .openOn(map);
                        console.log("before popup")
                        console.log(popup)
                        console.log("after popup")
                        setTimeout(function () {
                            var el = document.querySelector(".leaflet-popup");
                            console.log("On map:", map.hasLayer(popup));
                            console.log("Element:", el);
                            if (el) {
                                var cs = getComputedStyle(el);
                                console.log("Style:", cs.display, cs.visibility, cs.opacity);
                                console.log("Rect:", el.getBoundingClientRect());
                            }
                        }, 100);
                    });

                    layer.on(
                        "mouseover",
                        function (e) {

                            e.target.setStyle({
                                weight: 3,
                                fillOpacity: 0.35
                            });

                        }
                    );

                    layer.on(
                        "mouseout",
                        function (e) {

                            e.target.setStyle({
                                weight: 1,
                                fillOpacity: 0.15
                            });

                        }
                    );
                }

            }).addTo(map);

        })
        .catch(function (error) {

            console.error(
                "Unable to load congressional districts:",
                error
            );

            document.getElementById(
                "districtMap"
            ).innerHTML =
                '<div class="p-4 text-danger">' +
                '<strong>' +
                'Unable to load congressional district data.' +
                '</strong><br>' +
                error.message +
                '</div>';
        });
</script>